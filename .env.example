# TalentSia environment template — copy to .env and fill in. NEVER commit real values.

# --- Supabase (client) ---
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Gemini ---
# Server-side only. Set it as a Supabase Edge Function secret, NOT a VITE_ var:
#   supabase secrets set GEMINI_API_KEY=your_gemini_api_key
# A VITE_ prefix would compile the key into the public browser bundle.
